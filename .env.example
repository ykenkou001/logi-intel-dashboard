# e-Stat API（政府統計ポータル）
# 取得: https://www.e-stat.go.jp/api/ で利用登録
ESTAT_APP_ID=

# 国税庁 法人番号 API
# 取得: https://www.houjin-bangou.nta.go.jp/webapi/ で利用申込
CORP_NUMBER_APP_ID=

# 開発用: 1 を設定すると API キャッシュを強制バイパス
LOGI_CACHE_BYPASS=

# Google Analytics 4 (Measurement Protocol)
# 取得: GA4 → 管理 → データストリーム → 測定 ID（G-XXXXXXXXXX）
#       同画面の「Measurement Protocol API シークレット」を作成
# 両方未設定の場合は /api/v1/analytics/collect は 204 を返し計測オフ
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
