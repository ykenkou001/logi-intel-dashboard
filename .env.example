# e-Stat API（政府統計ポータル）
# 取得: https://www.e-stat.go.jp/api/ で利用登録
ESTAT_APP_ID=

# RESAS API（地域経済分析システム）
# 取得: https://opendata.resas-portal.go.jp/ でユーザー登録
RESAS_API_KEY=

# 国税庁 法人番号 API
# 取得: https://www.houjin-bangou.nta.go.jp/webapi/ で利用申込
CORP_NUMBER_APP_ID=

# 開発用: 1 を設定すると API キャッシュを強制バイパス
LOGI_CACHE_BYPASS=
